# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# --- Database (used by both docker-compose.yml and the Java app) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatdb
DB_USER=chatuser
DB_PASSWORD=chatpassword
DB_ROOT_PASSWORD=rootpassword

# --- Chat server (used by ChatServer.java and LoginScreenController.java) ---
SERVER_HOST=localhost
SERVER_PORT=5000
